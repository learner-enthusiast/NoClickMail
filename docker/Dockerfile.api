# syntax=docker/dockerfile:1

FROM node:22-alpine AS base
RUN apk add --no-cache libc6-compat
ENV PNPM_HOME="/pnpm"
ENV PATH="$PNPM_HOME:$PATH"
ENV TURBO_TELEMETRY_DISABLED=1
RUN corepack enable && corepack prepare pnpm@9.0.0 --activate
WORKDIR /app

FROM base AS pruner
COPY . .
RUN pnpm dlx turbo prune @repo/api --docker

FROM base AS builder
COPY --from=pruner /app/out/json/ .
COPY --from=pruner /app/out/pnpm-lock.yaml ./pnpm-lock.yaml
RUN pnpm install --frozen-lockfile
COPY --from=pruner /app/out/full/ .
RUN pnpm turbo build --filter=@repo/api

# pnpm deploy creates a self-contained prod bundle with correctly linked node_modules.
# Copying apps/api/node_modules + root node_modules breaks pnpm symlinks for packages
# like @corsair-dev/mcp that live only under node_modules/.pnpm.
RUN pnpm --filter @repo/api deploy --prod /app/api-deploy

RUN node -e "\
  process.chdir('/app/api-deploy'); \
  require('@corsair-dev/mcp'); \
  require('@openai/agents'); \
  require('corsair'); \
  require('pg'); \
  require('drizzle-orm'); \
  console.log('runtime deps OK'); \
"

FROM base AS runner
WORKDIR /app
ENV NODE_ENV=production
RUN addgroup --system --gid 1001 nodejs && adduser --system --uid 1001 nodejs

COPY --from=builder /app/api-deploy/ ./apps/api/
COPY --from=builder /app/packages/database/drizzle ./packages/database/drizzle
COPY docker/api-entrypoint.sh /usr/local/bin/api-entrypoint.sh
RUN chmod +x /usr/local/bin/api-entrypoint.sh

USER nodejs
EXPOSE 8000
ENTRYPOINT ["/usr/local/bin/api-entrypoint.sh"]
CMD ["node", "apps/api/dist/index.js"]
