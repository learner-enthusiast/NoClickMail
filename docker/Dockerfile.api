# syntax=docker/dockerfile:1

FROM node:22-alpine AS base
RUN apk add --no-cache libc6-compat
ENV PNPM_HOME="/pnpm"
ENV PATH="$PNPM_HOME:$PATH"
ENV TURBO_TELEMETRY_DISABLED=1
RUN corepack enable && corepack prepare pnpm@9.0.0 --activate
WORKDIR /app

FROM base AS pruner
COPY . .
RUN pnpm dlx turbo prune @repo/api --docker

FROM base AS builder
COPY --from=pruner /app/out/json/ .
COPY --from=pruner /app/out/pnpm-lock.yaml ./pnpm-lock.yaml
RUN pnpm install --frozen-lockfile
COPY --from=pruner /app/out/full/ .
RUN pnpm turbo build --filter=@repo/api

FROM base AS runner
WORKDIR /app
ENV NODE_ENV=production
# tsup externalizes @corsair-dev/*, @openai/agents, corsair — resolve from apps/api/node_modules
ENV NODE_PATH=/app/apps/api/node_modules:/app/node_modules
RUN addgroup --system --gid 1001 nodejs && adduser --system --uid 1001 nodejs

COPY --from=builder /app/apps/api/dist ./apps/api/dist
COPY --from=builder /app/apps/api/migrate.mjs ./apps/api/migrate.mjs
COPY --from=builder /app/apps/api/node_modules ./apps/api/node_modules
COPY --from=builder /app/node_modules ./node_modules
COPY --from=builder /app/apps/api/package.json ./apps/api/package.json
COPY --from=builder /app/packages/database/drizzle ./packages/database/drizzle
COPY docker/api-entrypoint.sh /usr/local/bin/api-entrypoint.sh
RUN chmod +x /usr/local/bin/api-entrypoint.sh

# pnpm keeps some externals only under node_modules/.pnpm. Docker COPY of
# apps/api/node_modules can drop those symlinks (notably @corsair-dev/mcp).
# Re-link the packages Node must resolve at runtime.
RUN set -eu \
  && mkdir -p /app/apps/api/node_modules/@corsair-dev /app/apps/api/node_modules/@openai \
  && ln -sfn "$(ls -d /app/node_modules/.pnpm/@corsair-dev+mcp@*/node_modules/@corsair-dev/mcp | head -1)" \
       /app/apps/api/node_modules/@corsair-dev/mcp \
  && ln -sfn "$(ls -d /app/node_modules/.pnpm/@openai+agents@*/node_modules/@openai/agents | head -1)" \
       /app/apps/api/node_modules/@openai/agents \
  && ln -sfn "$(ls -d /app/node_modules/.pnpm/corsair@*/node_modules/corsair | head -1)" \
       /app/apps/api/node_modules/corsair \
  && node -e "require('/app/apps/api/node_modules/@corsair-dev/mcp'); require('/app/apps/api/node_modules/@openai/agents'); require('/app/apps/api/node_modules/corsair'); console.log('runtime deps OK')"

USER nodejs
EXPOSE 8000
ENTRYPOINT ["/usr/local/bin/api-entrypoint.sh"]
CMD ["node", "apps/api/dist/index.js"]
