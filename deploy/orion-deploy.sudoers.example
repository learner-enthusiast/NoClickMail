# Passwordless systemctl for GitHub Actions home-server deploy.
# Install once on the server:
#
#   sudo cp deploy/orion-deploy.sudoers.example /etc/sudoers.d/orion-deploy
#   sudo chmod 440 /etc/sudoers.d/orion-deploy
#   sudo visudo -c
#
# Replace YOUR_DEPLOY_USER with the value of the GitHub SSH_USER secret.

YOUR_DEPLOY_USER ALL=(ALL) NOPASSWD: /bin/systemctl restart orion, /bin/systemctl is-active orion, /bin/systemctl status orion
