# =============================================================================
# Orion (NoClickMail) — environment variables
#
# Copy to .env at the repo root:
#   cp .env.example .env
#
# Loaded by:
#   apps/web, apps/api, packages/database, packages/services, packages/logger
#
# Deployment modes:
#   1. Local dev          — this file, docker compose postgres, pnpm dev
#   2. Split-host prod    — web on CLIENT_URL, API on BASE_URL (separate subdomains)
#   3. Home-server Docker — GitHub Actions builds images, SSH deploy; see README
# =============================================================================


# =============================================================================
# DATABASE
# =============================================================================

# --- Local dev (docker compose postgres) ---
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/dev

# --- Hosted Postgres (Neon / Supabase) ---
# Runtime: pooled URL is fine for the API.
# Migrations / pg_restore sync: use direct (non-pooler) URL in DATABASE_URL_DIRECT.
#
# DATABASE_URL=postgresql://user:pass@ep-xxx-pooler.neon.tech/neondb?sslmode=require
# DATABASE_URL_DIRECT=postgresql://user:pass@ep-xxx.neon.tech/neondb?sslmode=require

# --- Production Postgres in Docker (systemd app on host — docker-compose.prod-db.yml) ---
# POSTGRES_USER=postgres
# POSTGRES_PASSWORD=           # Keep stable — same password for pg_data volume across upgrades
# POSTGRES_DB=noclickmail
# POSTGRES_PORT=5432           # Bound to 127.0.0.1 only
# DATABASE_URL=postgresql://postgres:YOUR_PASSWORD@127.0.0.1:5432/noclickmail
# DATABASE_URL_DIRECT=postgresql://postgres:YOUR_PASSWORD@127.0.0.1:5432/noclickmail

# --- Home-server full Docker stack (docker-compose.deploy.yml) ---
# SYNC_DATABASE_URL=           # Remote Neon URL — daily backup target from local Postgres


# =============================================================================
# API SERVER
# =============================================================================

PORT=8000
BASE_URL=http://localhost:8000
CLIENT_URL=http://localhost:3000
CORS_ORIGIN=http://localhost:3000
NODE_ENV=development

# Shared cookie domain when web + API are on subdomains (e.g. .example.com)
# COOKIE_DOMAIN=.arnabsamanta.in


# =============================================================================
# JWT AUTH (required)
# Generate: openssl rand -base64 32
# =============================================================================

ACCESS_TOKEN_SECRET=replace-with-openssl-rand-base64-32-chars-min
REFRESH_TOKEN_SECRET=replace-with-another-openssl-rand-base64-32-chars
ACCESS_TOKEN_EXPIRY=1d
REFRESH_TOKEN_EXPIRY=30d


# =============================================================================
# FRONTEND (apps/web)
# =============================================================================

# Browser tRPC endpoint — baked into Next.js at build time; rebuild web after changing.
NEXT_PUBLIC_API_URL=http://localhost:8000/trpc

# Server-side Next.js → API (OAuth callback proxy route)
API_INTERNAL_URL=http://localhost:8000

# Docker / CI builds without full env:
# SKIP_ENV_VALIDATION=true


# =============================================================================
# GOOGLE OAUTH — sign-in (required)
# https://console.cloud.google.com/apis/credentials
# =============================================================================

GOOGLE_OAUTH_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_OAUTH_CLIENT_SECRET=your-google-client-secret

# Local (API-direct callback — recommended):
GOOGLE_OAUTH_REDIRECT_URI=http://localhost:8000/auth/google/callback

# Split-host prod (web orion.*, API orionserver.*):
# GOOGLE_OAUTH_REDIRECT_URI=https://orionserver.example.com/auth/google/callback
# CLIENT_URL=https://orion.example.com
# CORS_ORIGIN=https://orion.example.com
# NEXT_PUBLIC_API_URL=https://orionserver.example.com/trpc

# Home-server prod (single domain, nginx proxies /auth → API):
# CLIENT_URL=https://orion.example.com
# GOOGLE_OAUTH_REDIRECT_URI auto-defaults to https://orion.example.com/auth/google/callback
# NEXT_PUBLIC_API_URL=/trpc  (set at Docker build time)


# =============================================================================
# OPENAI (required — Orion Intelligence + embeddings)
# =============================================================================

OPENAI_API_KEY=sk-your-openai-api-key


# =============================================================================
# RAG EMBEDDINGS (pgvector in Postgres + optional Mem0 long-term memory)
# OPENAI_EMBEDDING_DIMENSIONS must match rag_embedding_chunks.embedding (1536 default)
# Requires Postgres with pgvector extension (see docker-compose postgres image)
# =============================================================================

OPENAI_EMBEDDING_MODEL=text-embedding-3-small
OPENAI_EMBEDDING_DIMENSIONS=1536
RAG_CHUNK_SIZE=600
RAG_CHUNK_OVERLAP=80

# Mem0 Platform — per-user long-term memory (https://app.mem0.ai)
# Extracts durable facts from chat turns; searched during RAG retrieve stage.
MEM0_API_KEY=


# =============================================================================
# INNGEST — background jobs (required in production for RAG ingest)
# Local: INNGEST_DEV=1 + pnpm --filter @repo/api inngest:dev (dashboard :8288)
# Prod:  keys from https://app.inngest.com — /api/inngest served by Express
# =============================================================================

INNGEST_DEV=1
# INNGEST_EVENT_KEY=
# INNGEST_SIGNING_KEY=


# =============================================================================
# CORSAIR — Gmail & Google Calendar (required in production)
# Run once after migrate: pnpm --filter @repo/api corsair:setup
# =============================================================================

# Encryption key (min 32 chars): openssl rand -base64 32
CORSAIR_KEK=replace-with-corsair-kek-min-32-chars

# User-facing redirects after connect — optional; default from CLIENT_URL:
#   ${CLIENT_URL}/dashboard/inbox
#   ${CLIENT_URL}/dashboard/calendar
# CORSAIR_GMAIL_REDIRECT_URI=http://localhost:3000/dashboard/inbox
# CORSAIR_CALENDAR_REDIRECT_URI=http://localhost:3000/dashboard/calendar

# API OAuth callback (Corsair connect flow) — optional; default:
#   ${CLIENT_URL}/connect/callback  (home-server: nginx proxies /connect → API)
# CORSAIR_CONNECT_REDIRECT_URI=http://localhost:8000/connect/callback

# Public HTTPS base for webhooks — optional; default BASE_URL or CLIENT_URL
# CORSAIR_WEBHOOK_BASE=https://your-public-https-url.example.com

# Min 16 chars — must match Pub/Sub push subscription ?token=
CORSAIR_WEBHOOK_SECRET=replace-with-random-secret-min-16-chars

# Gmail Pub/Sub topic for push notifications
GMAIL_PUBSUB_TOPIC_ID=projects/your-gcp-project/topics/your-topic-name


# =============================================================================
# FILE STORAGE — Amazon S3 / Cloudflare R2 (optional)
# Local dev: docker compose up -d minio  →  MinIO console http://localhost:9001
# Images are pulled from quay.io (Docker Hub minio/minio is often blocked/rate-limited)
# =============================================================================

# AWS_ACCESS_KEY_ID=minioadmin
# AWS_SECRET_ACCESS_KEY=minioadmin
# AWS_REGION=us-east-1
# AWS_S3_BUCKET=noclickmail-dev
# AWS_S3_ENDPOINT=http://localhost:9000
# AWS_S3_FORCE_PATH_STYLE=true
# AWS_S3_PUBLIC_BASE_URL=http://localhost:9000/noclickmail-dev

# Production S3 (real AWS — do NOT set AWS_S3_ENDPOINT or AWS_S3_FORCE_PATH_STYLE):
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_REGION=us-east-1
# AWS_S3_BUCKET=your-prod-bucket
# AWS_S3_PUBLIC_BASE_URL=https://your-prod-bucket.s3.us-east-1.amazonaws.com

# R2_ACCOUNT_ID=
# R2_ACCESS_KEY_ID=
# R2_SECRET_ACCESS_KEY=
# R2_BUCKET=
# R2_PUBLIC_BASE_URL=https://files.your-domain.example


# =============================================================================
# LOGGER (optional)
# =============================================================================

LOGGER_LEVEL=debug


# =============================================================================
# API DOCS (optional)
# =============================================================================

PUBLIC_OPENAPI_DOCS=true


# =============================================================================
# HOME-SERVER DOCKER ONLY (optional tuning — defaults in docker-compose.deploy.yml)
# =============================================================================

# Host port Docker exposes (nginx proxy). Point Cloudflare Tunnel at http://127.0.0.1:EXTERNAL_PORT
EXTERNAL_PORT=8080
# SYNC_MAX_ATTEMPTS=5
# SYNC_RETRY_DELAY_SECONDS=60
# SYNC_HOURLY_DELAY_SECONDS=3600
# SYNC_INTERVAL_SECONDS=86400
